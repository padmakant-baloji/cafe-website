{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "installCommand": "npm install && node scripts/check-vercel-functions.js",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__apiPath=$1" },
    { "source": "/api", "destination": "/api/index" },

    { "source": "/", "destination": "/login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/menu", "destination": "/index.html" },
    { "source": "/menu/", "destination": "/index.html" },

    { "source": "/admin/tables", "destination": "/admin-tables.html" },
    { "source": "/admin/tables/", "destination": "/admin-tables.html" },
    { "source": "/admin-tables", "destination": "/admin-tables.html" },
    { "source": "/admin-tables/", "destination": "/admin-tables.html" },
    { "source": "/admin-tables.html", "destination": "/admin-tables.html" },

    { "source": "/super-admin", "destination": "/super-admin.html" },
    { "source": "/super-admin/", "destination": "/super-admin.html" },

    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/admin.html", "destination": "/admin.html" },

    { "source": "/admin-login", "destination": "/admin-login.html" },
    { "source": "/admin-login/", "destination": "/admin-login.html" },
    { "source": "/admin-login.html", "destination": "/admin-login.html" },

    { "source": "/orders", "destination": "/orders.html" },
    { "source": "/orders/", "destination": "/orders.html" },

    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/profile/", "destination": "/profile.html" },

    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/privacy-policy/", "destination": "/privacy-policy.html" },

    { "source": "/download", "destination": "/download.html" },
    { "source": "/download/", "destination": "/download.html" },
    { "source": "/install", "destination": "/download.html" },
    { "source": "/install/", "destination": "/download.html" }
  ]
}
