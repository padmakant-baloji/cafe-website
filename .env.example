# Server (local: yarn start)
PORT=3000

# Neon Postgres (https://console.neon.tech) — pooled URL recommended for web apps (?sslmode=require).
# The app uses WebSocket Pool (not HTTP fetch); pooler hostnames are OK. Avoid channel_binding in the URL for Node.
DATABASE_URL=

# Neon local/dev controls (optional, for Neon tooling/workflows).
# If NEON_API_KEY + NEON_PROJECT_ID are set, app prefers Neon API over DATABASE_URL.
NEON_API_KEY=
NEON_PROJECT_ID=
BRANCH_ID=
PARENT_BRANCH_ID=
DELETE_BRANCH=true
NEON_DATABASE=neondb
NEON_ROLE=neondb_owner

# Signed session tokens for customers (change in production).
SESSION_SECRET=

# Admin dashboard Basic Auth (/admin). Defaults: balojicafe / admin
# These credentials always sign in to the default venue (Baloji Cafe Cafe).
ADMIN_USER=
ADMIN_PASS=

# Baloji Cafe Cafe is the main hotel (slug balojicafe, is_default in DB). Its admin uses ADMIN_USER/ADMIN_PASS above.
# Main admin can create other hotels from /admin → Hotels and give each property its own login.

# Production: balojicafe.com must run this app or a host with /api (e.g. Vercel with the
# `api/` folder in this repo). Pure static hosting returns 404 for POST /api/order.
# On Vercel, add the same variables in Project → Settings → Environment Variables.

# SMTP (e.g. Gmail App Password, SendGrid SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Who receives order emails (kitchen / owner inbox)
ORDER_TO_EMAIL=owner@example.com

# From address (often must match SMTP_USER for many providers)
ORDER_FROM_EMAIL=
