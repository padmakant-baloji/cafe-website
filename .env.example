# Server (local: yarn start)
PORT=3000

# Production: balojicafe.com must run this app or a host with /api (e.g. Vercel with the
# `api/` folder in this repo). Pure static hosting returns 404 for POST /api/order.
# On Vercel, add the same variables in Project → Settings → Environment Variables.

# SMTP (e.g. Gmail App Password, SendGrid SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Who receives order emails (kitchen / owner inbox)
ORDER_TO_EMAIL=owner@example.com

# From address (often must match SMTP_USER for many providers)
ORDER_FROM_EMAIL=
