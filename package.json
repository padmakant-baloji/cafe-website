{
  "name": "balojis-cafe-website",
  "private": true,
  "version": "1.0.0",
  "description": "Baloji's Cafe order site with email orders",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "db:test": "node scripts/db-test.js",
    "images:compress": "node scripts/compress-images.js",
    "pwa:icons": "node scripts/generate-pwa-icons.js",
    "android:keygen": "bash scripts/android-generate-keystore.sh",
    "android:sync-assetlinks": "node scripts/android-sync-assetlinks.js",
    "android:update": "cd android-twa && bubblewrap update",
    "android:build": "cd android-twa && bubblewrap build",
    "android:install": "cd android-twa && bubblewrap install",
    "android:check": "bash scripts/android-play-readiness.sh",
    "vercel:check": "node scripts/check-vercel-functions.js",
    "menu:seed-milan": "node scripts/seed-milan-udapi-menu.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "sharp": "^0.33.5",
    "nodemailer": "^6.9.16",
    "ws": "^8.20.0"
  }
}
