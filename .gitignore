# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editors / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.p12
*.key
credentials.json
service-account*.json

# --- Node ---
node_modules/
.npm
.eslintcache
.node_repl_history

# --- Yarn (Berry / modern) ---
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.yarn-integrity

# --- Package manager locks (keep yarn.lock committed) ---
package-lock.json

# --- Vercel ---
.vercel

# --- Test / coverage ---
coverage/
.nyc_output/

# --- Misc build / temp ---
dist/
tmp/
temp/
*.tmp
*.temp
.cache/

# Root "build/" only (do not use bare build/ — it is too broad for monorepos)
/build/

# --- Android TWA (Bubblewrap / Gradle) ---
# Signing keys — never commit
android-twa/**/*.keystore
android-twa/**/*.jks
android-twa/android-release.keystore

# Release binaries & Play Store artifacts
android-twa/**/*.apk
android-twa/**/*.aab
android-twa/**/*.ap_
android-twa/**/*.dex
android-twa/**/*.idsig
android-twa/app-release-*

# Gradle & Android Studio
android-twa/.gradle/
android-twa/**/.gradle/
android-twa/build/
android-twa/**/build/
android-twa/local.properties
android-twa/**/local.properties
android-twa/.idea/
android-twa/**/*.iml
android-twa/captures/
android-twa/.externalNativeBuild/
android-twa/.cxx/
android-twa/**/*.hprof

# Bubblewrap machine-specific config
android-twa/.bubblewrap/

# --- Optional local tooling ---
.cursor/
